<!-- FAQPage: jede Frage steht wortgleich sichtbar im <footer class="about">.
     Ohne sichtbare Entsprechung ist das Markup laut Google-Richtlinie ungültig. -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "inLanguage": "de",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Wie viele Kilometer hält ein Laufschuh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Als Faustregel gelten 600 bis 900 Kilometer. Die tatsächliche Haltbarkeit hängt von Körpergewicht, Laufstil, Untergrund und Dämpfungsmaterial ab. SchuhTracker ist deshalb pro Schuh einstellbar und startet mit 800 Kilometern als Vorgabe."
      }
    },
    {
      "@type": "Question",
      "name": "Werden meine Daten an einen Server gesendet?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nein. SchuhTracker speichert Schuhe und Läufe ausschließlich im lokalen Speicher deines Browsers. Es gibt kein Konto, keine Anmeldung, keine Cloud und keine Analyse- oder Werbeskripte. Die App lädt ausschließlich ihre eigenen Dateien."
      }
    },
    {
      "@type": "Question",
      "name": "Funktioniert SchuhTracker offline?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja. Nach dem ersten Aufruf liegt die App im Cache des Browsers und lässt sich als Progressive Web App auf dem Startbildschirm installieren. Danach startet sie auch ohne Internetverbindung."
      }
    },
    {
      "@type": "Question",
      "name": "Wie sichere ich meine Daten oder wechsle das Gerät?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Im Bereich Statistik gibt es unter „Daten & Backup“ einen Export als JSON-Datei. Diese Datei lässt sich auf einem anderen Gerät oder in einem anderen Browser wieder einspielen. Zusätzlich gibt es einen CSV-Export für Excel."
      }
    },
    {
      "@type": "Question",
      "name": "Was kostet SchuhTracker?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Nichts. Die App ist kostenlos, werbefrei und funktioniert ohne Benutzerkonto."
      }
    }
  ]
}
</script>